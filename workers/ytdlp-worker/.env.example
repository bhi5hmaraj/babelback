# Worker configuration (copy to .env and edit values)

# GCS bucket to upload audio into (required for /download uploads)
GCS_BUCKET=your-gcs-bucket

# Signed URL TTL in seconds (2h default)
GCS_SIGNED_URL_TTL_SECONDS=7200

# yt-dlp/ffmpeg settings
YTDLP_NO_UPDATE=1
XDG_CACHE_HOME=/tmp/ytcache

# Optional: path to a Netscape cookies.txt inside the container
# If you set this, also mount a file at that path when running Docker
# e.g., -v "$PWD/yt_cookie.txt:/secrets/cookies.txt:ro"
YTDLP_COOKIES_FILE=/secrets/cookies.txt

# Optional: force a specific User-Agent
YTDLP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36

# Optional: point to a service account key file inside the container
# and mount it via -v "/abs/path/key.json:/secrets/key.json:ro"
GOOGLE_APPLICATION_CREDENTIALS=/secrets/key.json

